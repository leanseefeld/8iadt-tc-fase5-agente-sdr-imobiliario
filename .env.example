# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env — see .gitignore.
# ---------------------------------------------------------------------------

# --- Model provider (OpenAI-compatible) ------------------------------------
# Local default is oMLX on Apple Silicon. It listens on 127.0.0.1 only, so a
# container cannot reach it through host.docker.internal without either
# reconfiguring oMLX to bind 0.0.0.0 or forwarding the port on the host.
# See docs/arquitetura/restricoes-de-implantacao.md before changing this.
#
#   From the host:        http://localhost:8990/v1
#   From a container:     http://host.docker.internal:8991/v1   (forwarded port)
PROVIDER_BASE_URL=http://host.docker.internal:8991/v1

# Required even for the local server — oMLX rejects unauthenticated requests.
PROVIDER_API_KEY=

# Model id or alias as exposed by the provider, e.g. gemma4:12b
MODEL_ID=gemma4:12b

# Bounded retry and timeout, so a conversation never hangs on the model.
MODEL_TIMEOUT_MS=30000
MODEL_MAX_RETRIES=2

# --- Database ---------------------------------------------------------------
# Host `db` is the Compose service name; localhost only when running outside it.
DATABASE_URL=postgresql://sdr:sdr@db:5432/sdr

# --- Observability (Langfuse) ----------------------------------------------
# Telemetry is fire-and-forget: the app must run normally with these unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://langfuse-web:3000

# --- Authentication ---------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Follow-up behaviour ----------------------------------------------------
# Starting hypotheses, not requirements — see docs/decisoes-pendentes.md item 4.
FOLLOWUP_WINDOW_START=09:00
FOLLOWUP_WINDOW_END=20:00
FOLLOWUP_TIMEZONE=America/Sao_Paulo
FOLLOWUP_FIRST_DELAY_HOURS=4
FOLLOWUP_MAX_ATTEMPTS=3
WORKER_SWEEP_INTERVAL_MS=900000

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
