# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env — see .gitignore.
# ---------------------------------------------------------------------------

# --- Model provider (OpenAI-compatible) ------------------------------------
# Local default is oMLX on Apple Silicon, configured to listen on 0.0.0.0, so a
# container reaches it directly. If a reinstall reverts it to loopback, see the
# contingency in docs/arquitetura/restricoes-de-implantacao.md section 1.
#
#   From the host:        http://localhost:8990/v1
#   From a container:     http://host.docker.internal:8990/v1
PROVIDER_BASE_URL=http://host.docker.internal:8990/v1

# Required even for the local server — oMLX rejects unauthenticated requests.
PROVIDER_API_KEY=

# Model id or alias as exposed by the provider. ADR 16 fixes this one for
# development and for the integration suite.
MODEL_ID=gemma-4-e4b-it-OptiQ-4bit

# Bounded retry and timeout, so a conversation never hangs on the model.
MODEL_TIMEOUT_MS=30000
MODEL_MAX_RETRIES=2

# Header carrying PROVIDER_API_KEY when the endpoint refuses
# `Authorization: Bearer`. Leave empty for Bearer, which is what oMLX wants.
PROVIDER_AUTH_HEADER=

# Injects chat_template_kwargs.enable_thinking into the request body. Costs
# roughly eight extra seconds a turn and needs the larger output ceiling below;
# the reasoning text reaches the trace and never the widget.
MODEL_THINKING=false

# Output ceiling per call, reasoning tokens included. Empty means 600, or 2000
# when MODEL_THINKING is true.
MODEL_MAX_OUTPUT_TOKENS=

# Recent messages sent to the model. Older context is the slot state, and later
# the conversation summary — never the whole transcript.
MODEL_HISTORY_WINDOW=12

# --- Conversation -----------------------------------------------------------
# Silence after the lead's last message before a turn starts, so a burst of
# short messages becomes one reply instead of three.
CHAT_DEBOUNCE_MS=3000

# Lead messages accepted per widget session inside the rolling window, and the
# longest single message. Over either, the lead gets a fixed template reply and
# the model is never called.
CHAT_MESSAGE_BUDGET=60
CHAT_BUDGET_WINDOW_MINUTES=30
CHAT_MAX_MESSAGE_CHARS=1000

# Humanising pause before the first chunk of a reply, as a range in
# milliseconds. Set to 0-0 to remove it, which is what the tests do.
CHAT_TYPING_DELAY_MS=300-800

# Keep-alive pulse on the SSE stream. Two missed pulses and the widget shows
# "Conexão perdida. Reconectando…" and stops accepting input.
SSE_PULSE_INTERVAL_MS=15000

# --- Database ---------------------------------------------------------------
# Host `db` is the Compose service name; localhost only when running outside it.
# The 5432 here is the port *inside* the Docker network and does not change.
DATABASE_URL=postgresql://sdr:sdr@db:5432/sdr

# Host port Postgres is published on, for a GUI client or psql from the host.
# Only this side is remappable — nothing inside the network uses it.
DB_PORT=55432

# --- Observability (Langfuse) ----------------------------------------------
# Telemetry is fire-and-forget: the app must run normally with these unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://langfuse-web:3000

# Host port the Langfuse UI is published on by the `observability` profile.
# Read by docker-compose.yml only, like DB_PORT.
LANGFUSE_UI_PORT=3102

# --- Authentication ---------------------------------------------------------
# Required — signs the session cookie. Neither process starts without it, and
# changing it invalidates every session in flight.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Broker surface ---------------------------------------------------------

# How long a conversation must be quiet before the worker summarises it, so a
# summary never lands in the middle of an exchange.
SUMMARY_DEBOUNCE_SECONDS=20

# Conversations summarised per sweep. Bounds the work one sweep can take.
SUMMARY_BATCH_SIZE=10

# Rows per page on /leads.
LEADS_PAGE_SIZE=25

# A lead counts as "ao vivo" while its last message is younger than this.
DASHBOARD_LIVE_WINDOW_MINUTES=10

# --- Follow-up behaviour ----------------------------------------------------
# Starting hypotheses, not requirements — see docs/decisoes-pendentes.md item 4.
FOLLOWUP_WINDOW_START=09:00
FOLLOWUP_WINDOW_END=20:00
FOLLOWUP_TIMEZONE=America/Sao_Paulo
# Minutes until the first follow-up. The demonstration uses 5 (see
# specs/006-scheduling-followup/quickstart.md §0); this is the production shape.
FOLLOWUP_FIRST_DELAY_MINUTES=240
FOLLOWUP_MAX_ATTEMPTS=3
# Each unanswered attempt waits this many times longer than the previous one.
FOLLOWUP_BACKOFF_FACTOR=3
# Due attempts a single sweep claims.
FOLLOWUP_BATCH_SIZE=20

# --- Scheduling (spec 006) ---------------------------------------------------
# No meeting is offered sooner than this many minutes from now.
SCHEDULING_MIN_NOTICE_MINUTES=120
# Hours a proposal tries, in preference order, inside each broker's availability.
SCHEDULING_PREFERRED_TIMES=10:00,14:00,16:30

# How often the worker wakes. Also the basis of its staleness check: readiness
# fails when the last completed sweep is older than three intervals.
WORKER_SWEEP_INTERVAL_MS=900000

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Port the Next.js application listens on, inside the container and published
# on the host. Change this one value to move the app.
APP_PORT=3100

# The worker is not otherwise an HTTP server; this port exists so a container
# orchestrator can ask it about its own health.
WORKER_HEALTH_PORT=3101

# macOS bind-mount file watching can lose events, which shows up as hot reload
# that never fires. Set true to fall back to polling, at a cost in CPU.
# See docs/arquitetura/restricoes-de-implantacao.md section 3.
WATCHPACK_POLLING=false
