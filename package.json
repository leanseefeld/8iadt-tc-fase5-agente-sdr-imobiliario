{
  "name": "sdr-imobiliario",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${APP_PORT:-3000}",
    "build": "NODE_ENV=production next build",
    "start": "next start -H 0.0.0.0 -p ${APP_PORT:-3000}",
    "start:worker": "node src/worker/index.ts",
    "doctor": "node scripts/doctor.ts",
    "lint": "eslint .",
    "test": "node --test tests/*.test.ts",
    "test:integration": "INTEGRATION=1 node --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.ts",
    "db:seed": "node src/db/seed/index.ts",
    "db:reset": "node src/db/reset.ts && node src/db/seed/index.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.44",
    "@ai-sdk/react": "4.0.96",
    "@langfuse/otel": "5.11.0",
    "@langfuse/tracing": "5.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "ai": "7.0.93",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pg": "^8.13.1",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
